ARTIFACTVAULT_DB_PATH=/data/artifactvault.db
ARTIFACTVAULT_STORAGE_ROOT=/data/storage
ARTIFACTVAULT_BIND=0.0.0.0:8080
ARTIFACTVAULT_GC_GRACE=24h
ARTIFACTVAULT_STAGING_TTL=24h
ARTIFACTVAULT_MAX_FILENAME_BYTES=1024
ARTIFACTVAULT_MAX_DESCRIPTION_BYTES=16384
ARTIFACTVAULT_MAX_TAGS=32
ARTIFACTVAULT_MAX_TAG_BYTES=128
# 0 means unlimited. Streaming remains bounded-memory.
ARTIFACTVAULT_MAX_ARTIFACT_BYTES=0
ARTIFACTVAULT_LOG_LEVEL=info
